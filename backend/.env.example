# ---- CloudGuard backend configuration -------------------------------------
# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# MongoDB connection string (local or MongoDB Atlas).
#   Local : mongodb://localhost:27017
#   Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave EMPTY to run in in-memory demo mode (no database needed).
MONGO_URI=
MONGO_DB_NAME=cloudguard

# Long random string used to sign login tokens (JWT).
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Allowed frontend origin(s) for CORS. Comma-separated for several.
FRONTEND_URL=http://localhost:5173

# Optional
PORT=5000
CLOUD_PROVIDER=simulated
AUTO_SEED=true
ALLOW_DEMO_LOGIN=true
